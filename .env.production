# Production build settings (read by `vite build`, including on GitHub Actions).
# The worker URL is public (browsers call it directly); access is protected by
# Firebase ID tokens and CORS, not by keeping this address secret.
# Local development overrides it through .env.local (git-ignored).
VITE_CALENDAR_WORKER_URL=https://blokly-calendar.blokly-calendar-worker.workers.dev
# Web Push public key (VAPID) — public by design; the private key is a worker secret.
VITE_VAPID_PUBLIC_KEY=BPsnp-kb_4Wrzxdgsd4qf8sJwYuCLlXd0OThJN5XM0ZlIdhpgmaQSMGL0Ps_i3V20z3dTVxVG0llkAnEtrWUpn0
